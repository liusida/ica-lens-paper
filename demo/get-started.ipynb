       "        return { token, value: raw === null ? Number(listed?.score) : Number(raw), visible: Boolean(listed) };\n",
       "      }).filter(item =&gt; Number.isFinite(item.value));\n",
       "      const strongest = observations.reduce((best, item) =&gt;\n",
