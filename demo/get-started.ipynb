       "        const context = String(item.context || &quot;&quot;).replace(/\\r\\n|\\r|\\n/g, &quot;↵&quot;);\n",
       "        lines.push(`${index + 1}. ${JSON.stringify(text)} · ${(Number(item.energy) * 100).toFixed(1)}% · ${context}`);\n",
